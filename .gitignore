# Personal fork: track nvim-pack-lock.json in version control (see
# :help vim.pack-lockfile) rather than ignoring it, per upstream's own
# recommendation for forks (only the official kickstart.nvim repo
# ignores it, to avoid template-merge conflicts).
# (vim.pack installs plugins under ~/.local/share/nvim/site/pack/, not
# inside this config dir, so there's no local pack/ to ignore here.)
